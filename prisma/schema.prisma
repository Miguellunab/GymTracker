generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Peso corporal ────────────────────────────────────────────
model WeightLog {
  id        String   @id @default(cuid())
  weight    Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─── Sesiones de entrenamiento ────────────────────────────────
model WorkoutSession {
  id              String   @id @default(cuid())
  date            DateTime @default(now())
  muscleGroup     String   // "Pecho/Espalda", "Pierna", "Brazos"
  durationMinutes Int?     // Duracion total en minutos
  totalCalories   Float?   // Calculado por AI

  didCardio       Boolean  @default(false)
  cardioType      String?  // Tipo libre: "caminadora", "eliptica", etc.
  cardioMinutes   Int?

  fatigueLevel    Int?     // 1-10, generado por AI
  nitRating       Int?     // 1-10 (nivel de intensidad total), generado por AI
  feeling         String?  // Texto libre del usuario sobre como se sintio

  notes           String?

  sets            WorkoutSet[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
  @@index([muscleGroup])
}

model ExerciseCatalog {
  id            String       @id @default(cuid())
  canonicalName String       @unique
  slug          String       @unique
  muscleGroup   String?
  equipment     String?
  aliases       String[]     @default([])
  isActive      Boolean      @default(true)
  isAmbiguous   Boolean      @default(false)
  sets          WorkoutSet[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([muscleGroup])
  @@index([slug])
}

model WorkoutSet {
  id                String   @id @default(cuid())
  workoutSessionId  String
  exerciseId        String?
  exerciseName      String   // Nombre canónico mostrado al usuario
  originalInput     String?  // Texto original escrito por el usuario
  weight            Float    // kg
  sets              Int      // Numero de series
  reps              Int      // Repeticiones por serie

  session   WorkoutSession  @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise  ExerciseCatalog? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([workoutSessionId])
  @@index([exerciseId])
  @@index([exerciseName])
}

// ─── Reportes AI ──────────────────────────────────────────────
model DailyReport {
  id         String   @id @default(cuid())
  date       DateTime @unique // Un reporte por dia
  content    String   // JSON stringificado con el analisis del dia
  weekNumber Int
  year       Int
  createdAt  DateTime @default(now())

  @@index([weekNumber, year])
}

model WeeklyReport {
  id         String   @id @default(cuid())
  weekNumber Int
  year       Int
  content    String   // JSON stringificado con analisis semanal
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([weekNumber, year])
}

// ─── Telegram ─────────────────────────────────────────────────
model TelegramMessage {
  id        String   @id @default(cuid())
  chatId    String
  messageId Int      // ID del mensaje en Telegram para poder borrarlo
  sentAt    DateTime @default(now())

  @@index([chatId])
  @@index([sentAt])
}
